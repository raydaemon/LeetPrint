{
  "manifest_version": 3,
  "name": "LeetPrint",
  "version": "6.11.702",
  "version_name": "6.11.0702",
  "description": "Adds a Print button to LeetCode problem and solution pages.",
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://leetcode.cn/problems/*",
        "https://leetcode.com/contest/*/problems/*",
        "https://leetcode.cn/contest/*/problems/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
